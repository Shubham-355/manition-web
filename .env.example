# Copy to .env and fill in. .env is gitignored.

# ---- Database (PostgreSQL) ----
# Prisma reads this through prisma.config.ts, the app reads it at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# ---- Outgoing mail (custom domain SMTP) ----
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
# Leave unset to infer from the port: implicit TLS on 465, STARTTLS otherwise.
# SMTP_SECURE="true"
SMTP_USER="you@example.com"
SMTP_PASS=""

# What recipients see in the From line. Falls back to SMTP_USER.
MAIL_FROM="Manition <you@example.com>"
# Optional, defaults to the From address.
# MAIL_REPLY_TO="you@example.com"

# ---- Site ----
# Absolute origin used for links inside the email. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://manition.pro"
